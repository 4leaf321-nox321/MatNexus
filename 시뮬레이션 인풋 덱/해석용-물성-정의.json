    {
      "key": "ansys",
      "label": "Ansys Mechanical APDL",
      "description": "MP + TB,PLASTIC,,,,MISO + TBPT — 자유 형식. TBPT 는 소성변형률 vs 진응력. 열물성이 있으면 MP,ALPX/C/KXX 로 함께 나간다.",
      "is_active": true,
      "definition": {
        "key": "ansys",
        "label": "Ansys Mechanical APDL",
        "lines": [
          {
            "text": "! {name}"
          },
          {
            "text": "! Consistent units: {units}"
          },
          {
            "note": "밀도가 카드에 없어 MP,DENS 를 빼고 그 사실을 덱 주석에 적었습니다.",
            "text": "! DENSITY: no measured value. MP,DENS omitted -- no dynamics, no body loads.",
            "when": "missing:elastic.density"
          },
          {
            "text": "/PREP7"
          },
          {
            "fields": [
              {
                "value": "elastic.youngs_modulus",
                "format": "free"
              }
            ],
            "prefix": "MP,EX,1,"
          },
          {
            "fields": [
              {
                "value": "elastic.poisson_ratio",
                "format": "free"
              }
            ],
            "prefix": "MP,NUXY,1,"
          },
          {
            "when": "elastic.density",
            "fields": [
              {
                "value": "elastic.density",
                "format": "free"
              }
            ],
            "prefix": "MP,DENS,1,"
          },
          {
            "when": "thermal.thermal_expansion",
            "fields": [
              {
                "value": "thermal.thermal_expansion",
                "format": "free"
              }
            ],
            "prefix": "MP,ALPX,1,"
          },
          {
            "when": "thermal.specific_heat",
            "fields": [
              {
                "value": "thermal.specific_heat",
                "format": "free"
              }
            ],
            "prefix": "MP,C,1,"
          },
          {
            "when": "thermal.thermal_conductivity",
            "fields": [
              {
                "value": "thermal.thermal_conductivity",
                "format": "free"
              }
            ],
            "prefix": "MP,KXX,1,"
          },
          {
            "text": "! NPTS is left blank -- Ansys counts the TBPT lines."
          },
          {
            "text": "TB,PLASTIC,1,,,MISO"
          },
          {
            "x": "plastic_strain",
            "y": "true_stress",
            "join": ",",
            "rows": "table",
            "fields": [
              {
                "value": "plastic_strain",
                "format": "free"
              },
              {
                "value": "true_stress",
                "format": "free"
              }
            ],
            "prefix": "TBPT,,"
          },
          {
            "text": "FINISH"
          }
        ],
        "needs": [
          {
            "block": "elastic",
            "values": [
              "youngs_modulus",
              "poisson_ratio"
            ]
          },
          {
            "block": "table",
            "rows_min": 2
          },
          {
            "block": "thermal",
            "optional": true
          }
        ],
        "describe": "MP + TB,PLASTIC,,,,MISO + TBPT — 자유 형식. TBPT 는 소성변형률 vs 진응력. 열물성이 있으면 MP,ALPX/C/KXX 로 함께 나간다.",
        "keywords": [
          "MP,EX",
          "TB,PLASTIC",
          "TBPT"
        ],
        "extension": "dat"
      }
    },
