<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>측정 가능 범위</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@300;400;500;600&display=swap">
<style>
:root{
  --bg:#EDEFEC; --surface:#F8F9F6; --sunk:#E3E7E1;
  --ink:#17211E; --ink2:#39443F; --muted:#67736D; --rule:#CBD2CA;
  --accent:#0E5F5A; --accent-ink:#0E5F5A; --accent-bg:#DCE9E6;
  --hot:#B33C29; --hot-bg:#F1DFD9;
  --cold:#2F6FC4;
  --col:44rem; --mid:53rem; --wide:62rem;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0F1411; --surface:#161D19; --sunk:#1D2621;
    --ink:#E7EBE5; --ink2:#C2CBC5; --muted:#8D9A93; --rule:#2A342E;
    --accent:#63C6B4; --accent-ink:#7ED3C3; --accent-bg:#12302B;
    --hot:#E8735A; --hot-bg:#2E1A15;
    --cold:#6FA5E6;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1411; --surface:#161D19; --sunk:#1D2621;
  --ink:#E7EBE5; --ink2:#C2CBC5; --muted:#8D9A93; --rule:#2A342E;
  --accent:#63C6B4; --accent-ink:#7ED3C3; --accent-bg:#12302B;
  --hot:#E8735A; --hot-bg:#2E1A15;
  --cold:#6FA5E6;
}
*{box-sizing:border-box}
body{
  background:var(--bg); color:var(--ink);
  font-family:"IBM Plex Sans KR","Apple SD Gothic Neo",system-ui,sans-serif;
  font-weight:350; font-size:16.5px; line-height:1.78;
  margin:0; padding:0 1.25rem 7rem;
  -webkit-font-smoothing:antialiased;
}
p{margin:0}
a{color:var(--accent-ink)}
strong{font-weight:600;color:var(--ink)}
em{font-style:normal;background:var(--accent-bg);padding:.05em .3em;border-radius:2px}

/* ---------- masthead ---------- */
header.mast{max-width:var(--wide);margin:0 auto;padding:5rem 0 3rem;border-bottom:1px solid var(--rule)}
.eyebrow{font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:.72rem;letter-spacing:.18em;
  text-transform:uppercase;color:var(--muted)}
h1{font-family:"Gowun Batang",serif;font-weight:700;font-size:clamp(2.3rem,6vw,3.7rem);
  line-height:1.14;margin:.9rem 0 0;text-wrap:balance;letter-spacing:-.01em}
.dek{max-width:38rem;margin-top:1.5rem;color:var(--ink2);font-size:1.06rem}
.mast-meta{display:flex;flex-wrap:wrap;gap:.5rem 2.2rem;margin-top:2.4rem;
  font-family:"IBM Plex Mono",monospace;font-size:.78rem;color:var(--muted)}
.mast-meta b{color:var(--ink2);font-weight:500}

/* ---------- toc ---------- */
nav.toc{max-width:var(--wide);margin:2.6rem auto 0;
  display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:.1rem 2rem}
nav.toc a{display:flex;gap:.8rem;padding:.42rem 0;border-bottom:1px solid var(--rule);
  text-decoration:none;color:var(--ink2);font-size:.9rem}
nav.toc a:hover{color:var(--accent-ink)}
nav.toc span{font-family:"IBM Plex Mono",monospace;font-size:.78rem;color:var(--muted);
  font-variant-numeric:tabular-nums}

/* ---------- flow ---------- */
main{display:flex;flex-direction:column;gap:5rem;margin-top:5rem}
section{display:flex;flex-direction:column;gap:1.2rem;scroll-margin-top:2rem}
/* specificity note: these must outrank the element rules below (p, h2, pre, ul, figure),
   otherwise their `margin:0` cancels the centering. */
main section>*{width:100%;max-width:var(--col);margin-inline:auto}
main section>.tw,main section>pre,main section>.eq,main section>.cards{max-width:var(--mid)}
main section>figure,main section>.wide{max-width:var(--wide)}

h2{font-family:"Gowun Batang",serif;font-weight:700;font-size:clamp(1.6rem,3.4vw,2.15rem);
  line-height:1.28;margin:0;text-wrap:balance}
h2 .num{display:block;font-family:"IBM Plex Mono",monospace;font-size:.74rem;font-weight:400;
  letter-spacing:.2em;color:var(--accent-ink);margin-bottom:.7rem}
h3{font-size:1.02rem;font-weight:600;margin:1.6rem 0 -.35rem;color:var(--ink)}
h3::before{content:"— ";color:var(--muted)}
h4{font-size:.82rem;font-weight:600;margin:0;letter-spacing:.02em;
  font-family:"IBM Plex Mono",monospace;color:var(--muted);text-transform:uppercase}
.lede{font-size:1.08rem;color:var(--ink2)}

ul,ol{margin:0;padding-left:1.35rem;display:flex;flex-direction:column;gap:.4rem}
li::marker{color:var(--muted)}
ul.tight,ol.tight{gap:.15rem}

/* ---------- equations ---------- */
.eq{background:var(--surface);border:1px solid var(--rule);border-left:2px solid var(--accent);
  border-radius:3px;padding:1rem 1.15rem;font-family:"IBM Plex Mono",ui-monospace,monospace;
  font-size:.93rem;line-height:1.95;overflow-x:auto;white-space:pre}
.eq .cm{color:var(--muted);font-size:.84em}
.eqn{color:var(--muted);font-size:.8rem;font-family:"IBM Plex Mono",monospace;margin-top:-.55rem}

/* ---------- code ---------- */
pre{background:var(--sunk);border:1px solid var(--rule);border-radius:3px;
  padding:1.05rem 1.15rem;overflow-x:auto;margin:0;
  font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:.83rem;line-height:1.72;
  font-variant-numeric:tabular-nums}
pre b{color:var(--accent-ink);font-weight:500}
pre i{color:var(--muted);font-style:normal}
code{font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:.87em;
  background:var(--sunk);padding:.1em .35em;border-radius:2px}

/* ---------- tables ---------- */
.tw{overflow-x:auto;border:1px solid var(--rule);border-radius:3px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:.86rem;min-width:34rem}
th,td{text-align:left;padding:.58rem .85rem;border-bottom:1px solid var(--rule);vertical-align:top}
thead th{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.09em;
  text-transform:uppercase;color:var(--muted);font-weight:500;background:var(--sunk)}
tbody tr:last-child td{border-bottom:0}
td.n,th.n{font-family:"IBM Plex Mono",monospace;font-variant-numeric:tabular-nums;text-align:right}
td.k{font-family:"IBM Plex Mono",monospace;color:var(--accent-ink);white-space:nowrap}

/* ---------- callouts ---------- */
.note{border:1px solid var(--rule);border-radius:3px;background:var(--surface);
  padding:1.05rem 1.2rem;display:flex;flex-direction:column;gap:.55rem;font-size:.94rem}
.note.trap{background:var(--hot-bg);border-color:transparent}
.note.trap h4{color:var(--hot)}
.note.trap strong{color:var(--hot)}

.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(15.5rem,1fr));gap:1rem}
.card{border:1px solid var(--rule);border-radius:3px;background:var(--surface);
  padding:1rem 1.1rem;display:flex;flex-direction:column;gap:.5rem;font-size:.9rem}
.card h4{color:var(--accent-ink)}

/* ---------- figures ---------- */
figure{margin:0;display:flex;flex-direction:column;gap:.85rem}
.fbox{border:1px solid var(--rule);border-radius:3px;background:var(--surface);
  padding:1.4rem 1.2rem;overflow-x:auto}
figcaption{font-size:.85rem;color:var(--muted);max-width:44rem;margin-inline:auto;text-align:center}
figcaption b{color:var(--ink2);font-weight:500}
svg{display:block;max-width:100%;height:auto;color:var(--ink)}

/* ---------- misc ---------- */
.steps{counter-reset:s;display:flex;flex-direction:column;gap:1.15rem;padding:0;list-style:none}
.steps>li{counter-increment:s;position:relative;padding-left:3rem}
.steps>li::before{content:counter(s,decimal-leading-zero);position:absolute;left:0;top:.3rem;
  font-family:"IBM Plex Mono",monospace;font-size:.78rem;color:var(--accent-ink);letter-spacing:.05em}
.steps b{display:block;font-weight:600}
hr{border:0;border-top:1px solid var(--rule);width:100%;max-width:var(--col);margin:.6rem auto}
footer{max-width:var(--wide);margin:6rem auto 0;padding-top:1.6rem;border-top:1px solid var(--rule);
  font-size:.82rem;color:var(--muted);font-family:"IBM Plex Mono",monospace}
::selection{background:var(--accent-bg)}
a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
@media (max-width:640px){
  body{font-size:16px}
  header.mast{padding-top:3rem}
  main{gap:3.6rem}
  .fbox{padding:.9rem .6rem}
}
</style></head><body>