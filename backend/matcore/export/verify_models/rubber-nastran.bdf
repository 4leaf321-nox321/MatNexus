$-------------------------------------------------------------------------------
$ MatNexus 1-element verification model -- rubber tension -- MSC Nastran SOL 400
$
$   units : mm - N - tonne - s   (stress MPa)
$   model : 1 x 1 x 1 mm CHEXA, 1/8 symmetry, x-face pulled to u = @@PULL@@ mm
$   check : sigma_x against expected.csv (see README.txt)
$   source: repository example rubber-1elem-nastran.bdf with the material
$           replaced by the card exactly as MatNexus exports it (MID 1)
$
$   Hyperelasticity is large strain by definition: NLMOPTS,LRGSTRN,1 and the
$   advanced solid (PSOLID + PSLDN1) as in the plasticity model.
$-------------------------------------------------------------------------------
SOL 400
CEND
TITLE    = MatNexus 1-element rubber tension (mm-N-tonne-s)
ECHO     = NONE
$
SUBCASE 1
  LABEL = stretch x face
  ANALYSIS     = NLSTATICS
  SPC          = 1
  LOAD         = 2
  NLPARM       = 10
  DISPLACEMENT(PLOT) = ALL
  STRESS(PLOT)       = ALL
  STRAIN(PLOT)       = ALL
  SPCFORCES(PLOT)    = ALL
$
BEGIN BULK
$
PARAM,LGDISP,1
PARAM,POST,-1
NLMOPTS,LRGSTRN,1
$
$       ID      NINC    DT      KMETHOD KSTEP   MAXITER CONV    INTOUT
NLPARM  10      50              FNT     5       25      PW      YES
$
$===============================================================================
$ MESH
$===============================================================================
$       ID                      X       Y       Z
GRID    1               0.0     0.0     0.0
GRID    2               1.0     0.0     0.0
GRID    3               1.0     1.0     0.0
GRID    4               0.0     1.0     0.0
GRID    5               0.0     0.0     1.0
GRID    6               1.0     0.0     1.0
GRID    7               1.0     1.0     1.0
GRID    8               0.0     1.0     1.0
$
$       EID     PID     G1      G2      G3      G4      G5      G6
CHEXA   1       1       1       2       3       4       5       6
+       7       8
$
$       PID     MID     CORDM
PSOLID  1       1       0
$ advanced (large strain) solid: C8 = 8-node hex, BEH = SOLID, INT = L
PSLDN1  1       1
+       C8      SOLID   L
$
$===============================================================================
$ MATERIAL -- as exported by MatNexus
$===============================================================================
@@MATERIAL@@
$
$===============================================================================
$ BOUNDARY CONDITIONS   (1/8 symmetry + enforced displacement)
$===============================================================================
$       SID     C       G1      G2      G3      G4
SPC1    1       1       1       4       5       8
SPC1    1       2       1       2       5       6
SPC1    1       3       1       2       3       4
SPC1    1       1       2       3       6       7
$
$       SID     G1      C1      D1      G2      C2      D2
SPCD    2       2       1       @@PULL8@@3       1       @@PULL8@@
SPCD    2       6       1       @@PULL8@@7       1       @@PULL8@@
$
ENDDATA
