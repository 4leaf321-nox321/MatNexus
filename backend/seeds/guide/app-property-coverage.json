pan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","content":[{"type":"text","text":"json"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","content":[{"type":"text","text":"없음 — 중립 형식"}]}]}]},{"type":"tableRow","content":[{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"덱 템플릿"}]}]},{"type":"tableCell","attrs":{"colspan":1,"rowspan":1,"colwidth":null,"align":null},"content":[{"type":"paragraph","content":[{"type":"text","text":"파일로 정의 — "},{"type":"text","marks":[{"type":"bold"}],"text":"배포 없이 새 솔버"},{"type":"text","text":". 자유 형식 · 고정 8 / 10 / 20칸을 다 냅니다"}]}]}]}]}]}},{"key":"03-어디서-끊기나","title":"03 · 어디서 끊기나","position":4,"body":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"◐ 여섯과 ○ 여섯은 "},{"type":"text","marks":[{"type":"bold"}],"text":"끊기는 자리가 서로 다릅니다."},{"type":"text","text":" 그 자리가 곧 다음에 할 일의 크기입니다."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"1. 솔버가 하나뿐 — 초탄성 · 점탄성"}]},{"type":"paragraph","content":[{"type":"text","text":"둘 다 "},{"type":"text","marks":[{"type":"bold"}],"text":"담기부터 카드까지는 다 됩니다."},{"type":"text","text":" Abaqus 렌더러만 있어서 거기서 멈춥니다. 그런데 이것은 "},{"type":"text","marks":[{"type":"bold"}],"text":"덱 템플릿으로 풀리는 종류"},{"type":"text","text":"입니다 — 코드가 아니라 파일 하나를 더 쓰면 됩니다."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"2. 카드 자리가 없다 — 항복강도 · 인장강도 · 연신율 · Tg"}]},{"type":"paragraph","content":[{"type":"text","text":"처리가 값을 잘 냅니다. 다만 그 값이 "},{"type":"text","marks":[{"type":"bold"}],"text":"덱에 실리는 자리가 없"},{"type":"text","text":"어서 요약값으로만 남습니다. 통계·비교에는 이미 쓰이지만 해석으로는 안 갑니다."}]},{"type":"blockquote","content":[{"type":"paragraph","content":[{"type":"text","text":"이건 "},{"type":"text","marks":[{"type":"bold"}],"text":"빠뜨린 것이 아닐 수 있습니다."},{"type":"text","text":" 항복강도는 소성 표가 이미 담고 있고(표의 첫 점), Tg 는 Prony 카드의 기준 온도로 들어갑니다. "},{"type":"text","marks":[{"type":"bold"}],"text":"한 자리는 한 블록이 채운다"},{"type":"text","text":"는 규칙 때문에 일부러 안 넣은 것에 가깝습니다 — 둘이 채우면 어느 값이 덱에 실렸는지 알 수 없어집니다."}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"3. 카드가 막는다 — 온도 의존 소성"}]},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"탄성은 온도별 표가 됩니다."},{"type":"text","text":" "},{"type":"text","marks":[{"type":"code"}],"text":"*ELASTIC"},{"type":"text","text":" 이 온도 열을 받고, 빈 칸이 있으면 덱을 안 내고 멈춥니다(이웃 값으로 메우지 않습니다). 그런데 "},{"type":"text","marks":[{"type":"bold"}],"text":"소성 표에는 온도 축이 없습니다"},{"type":"text","text":" — (변형률, 응력) 두 열뿐입니다."}]},{"type":"paragraph","content":[{"type":"text","text":"담기와 처리는 이미 됩니다. 온도별로 인장을 담아 각각 처리하면 곡선이 여럿 나옵니다. "},{"type":"text","marks":[{"type":"bold"}],"text":"그 여럿을 한 카드에 묶는 자리가 없"},{"type":"text","text":"는 것이 전부입니다."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"4. 시험이 없다 — 속도 · 크리프 · 복합재 · 폼"}]},{"type":"paragraph","content":[{"type":"text","text":"담기 단계부터 비어 있습니다. 처리 플러그인이 "},{"type":"text","marks":[{"type":"code"}],"text":"tensile"},{"type":"text","text":" 과 "},{"type":"text","marks":[{"type":"code"}],"text":"dma_sweep"},{"type":"text","text":" 에만 붙어 있어서, 다른 종류의 곡선은 담겨도 그 위에서 할 일이 없습니다."}]},{"type":"blockquote","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"이것이 「하나만 만들면 되는」 일이 아니다"}]},{"type":"paragraph","content":[{"type":"text","text":"예컨대 폼 하나를 끝까지 보내려면 "},{"type":"text","marks":[{"type":"bold"}],"text":"다섯 자리를 다 만들어야"},{"type":"text","text":" 합니다 — 압축 시험 종류 · 압축 곡선 처리 · (선택) 식 · 폼 카드 블록 · 덱 템플릿. 반대로 "},{"type":"text","marks":[{"type":"bold"}],"text":"온도 의존 소성은 카드 하나"},{"type":"text","text":"면 열립니다. "},{"type":"text","marks":[{"type":"bold"}],"text":"같은 ○ 라도 거리가 다릅니다."}]}]}]}},{"key":"04-늘리려면-무엇을-하나","title":"04 · 늘리려면 무엇을 하나","position":5,"body":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"가까운 것부터 적었습니다. 앞의 둘은 "},{"type":"text","marks":[{"type":"bold"}],"text":"중심 코드를 안 건드리고"},{"type":"text","text":" 됩니다."}]},{"type":"orderedList","attrs":{"start":1,"type":null},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"덱 템플릿을 쓴다 — 파일 하나"}]},{"type":"paragraph","content":[{"type":"text","text":"초탄성·점탄성을 Abaqus 밖으로 내보내는 일, LS-DYNA·OptiStruct·Radioss 를 붙이는 일이 여기 듭니다. "},{"type":"text","marks":[{"type":"bold"}],"text":"배포가 필요 없"},{"type":"text","text":"고, 칸 폭(8·10·20칸)까지 템플릿이 냅니다."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"확장 폴더를 만든다 — 파일 두세 개"}]},{"type":"paragraph","content":[{"type":"text","text":"새 경화식·새 초탄성 식은 "},{"type":"text","marks":[{"type":"code"}],"text":"extensions/<이름>/"},{"type":"text","text":" 하나로 끝납니다. "},{"type":"text","marks":[{"type":"bold"}],"text":"Ghosh 가 그 증거"},{"type":"text","text":"입니다 — 중심 코드를 한 줄도 안 고치고 붙었습니다."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"카드 블록을 더한다 — 중심 코드"}]},{"type":"paragraph","content":[{"type":"text","text":"온도 의존 소성, 속도 의존 계수, 크리프 상수처럼 "},{"type":"text","marks":[{"type":"bold"}],"text":"덱에 새 자리가 필요한"},{"type":"text","text":" 것. 블록 하나가 무엇을 담는지 정하는 일이라 신중해야 합니다 — "},{"type":"text","marks":[{"type":"bold"}],"text":"한 자리는 한 블록이 채웁니다."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"시험 종류와 처리를 더한다 — 가장 큰 일"}]},{"type":"paragraph","content":[{"type":"text","text":"압축·크리프·복합재처럼 "},{"type":"text","marks":[{"type":"bold"}],"text":"담기부터 없는"},{"type":"text","text":" 것. 장비 파일을 읽는 규칙(형식 프로필)까지 딸려 옵니다."}]}]}]},{"type":"blockquote","content":[{"type":"heading","attrs":{"level":4},"content":[{"type":"text","text":"다른 표와 함께 본다"}]},{"type":"paragraph","content":[{"type":"text","text":"이 표는 "},{"type":"text","marks":[{"type":"bold"}],"text":"앱이 무엇을 다루나"},{"type":"text","text":"이고, 「물성 × 장비 대응표」는 "},{"type":"text","marks":[{"type":"bold"}],"text":"장비로 무엇을 재나"},{"type":"text","text":"입니다. 둘을 겹치면 우선순위가 나옵니다 — "},{"type":"text","marks":[{"type":"bold"}],"text":"잴 수 있는데 앱이 못 받는 것"},{"type":"text","text":"이 가장 아까운 자리입니다."}]},{"type":"paragraph","content":[{"type":"text","text":"지금 그 자리에 있는 것: "},{"type":"text","marks":[{"type":"bold"}],"text":"온도 의존 소성"},{"type":"text","text":"(온도챔버가 있으면 잴 수 있고, 카드 하나면 열립니다)과 "},{"type":"text","marks":[{"type":"bold"}],"text":"폼 압축"},{"type":"text","text":"(고속 압축기가 있으면 잴 수 있으나 다섯 자리가 다 비었습니다)."}]}]}]}}],"assets":[]}