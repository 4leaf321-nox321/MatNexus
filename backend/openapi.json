        "type": "object"
      },
      "TemporaryPasswordResponse": {
        "description": "임시 비밀번호는 이 응답에서 한 번만 나온다.\n\nSMTP 가 없어 메일로 보낼 수 없으므로, 관리자가 화면에서 읽어 구두·메신저로\n전달한다. 받는 사람은 첫 로그인 때 변경이 강제된다.",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountOut"
          },
          "temporary_password": {
            "title": "Temporary Password",
            "type": "string"
          }
        },
        "required": [
          "account",
          "temporary_password"
        ],
        "title": "TemporaryPasswordResponse",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "home_workspace_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Workspace Slug"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
