{
  "schema": "matnexus.tensile.coordinate_projection_v1_candidate_examples/1",
  "description": "R46 variant C coordinate-projection v1 candidate examples. This importable seven-method set is explicit opt-in only; it is not a default recipe set, not solver-approved, and not material-card approval. It preserves the externally replay-validated step/options sequences, including source E/Rp, the raw source-stress snapshot, coordinate projection, post-true-plastic order guard, proof-anchor guard, and downstream stages. Offline replay evidence does not claim live main-orchestrator acceptance or solver suitability.",
  "recipes": [
    {
      "key": "r46_coordinate_projection_v1_candidate_lower_envelope",
      "label": "R46 좌표 투영 v1 후보·opt-in 예시 — 하측 포락선",
      "description": "R46 variant C coordinate-projection v1 candidate/opt-in example for method lower_envelope. It preserves the externally replay-validated 18-stage step/options sequence. Select only by explicit review; it is not a default recipe, not solver-approved, and not material-card approval.",
      "test_type_key": "tensile",
      "steps": [
        {
          "plugin": "tensile.engineering",
          "options": {
            "gauge_length": "@specimen_gauge_length",
            "area": "@specimen_area"
          }
        },
        {
          "plugin": "tensile.terminal_domain",
          "options": {
            "policy": "terminal_loss_auto_v2",
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "time": "time"
          }
        },
        {
          "plugin": "tensile.strength",
          "options": {}
        },
        {
          "plugin": "tensile.source_elastic_modulus_v2",
          "options": {
            "policy": "auto_rows_v2"
          }
        },
        {
          "plugin": "tensile.source_proof_stress",
          "options": {
            "offset_strain": 0.002
          }
        },
        {
          "plugin": "tensile.necking_candidate",
          "options": {}
        },
        {
          "plugin": "tensile.model_support",
          "options": {}
        },
        {
          "plugin": "tensile.source_stress_snapshot",
          "options": {
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "snapshot": "stress_engineering_source_snapshot"
          }
        },
        {
          "plugin": "tensile.band_model",
          "options": {
            "policy": "band_and_source_events_auto_v1",
            "method": "lower_envelope",
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "time": "time",
            "minimum_band_rows": 20,
            "minimum_progress_span": 0.1,
            "maximum_stress_over_peak": 0.9,
            "maximum_range_over_peak": 0.02,
            "maximum_gap_over_band_span": 0.1,
            "loading_floor_fraction": 0.4
          }
        },
        {
          "plugin": "tensile.model_anchor",
          "options": {
            "offset_strain": 0.002,
            "youngs_modulus": "@youngs_modulus"
          }
        },
        {
          "plugin": "tensile.coordinate_projected_v1",
          "options": {
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "snapshot": "stress_engineering_source_snapshot",
            "source_index": "model_input_index",
            "youngs_modulus": "@youngs_modulus",
            "proof_strain": "@model_proof_strain",
            "proof_stress": "@model_proof_stress",
            "offset_strain": "@model_proof_offset"
          }
        },
        {
          "plugin": "tensile.effective_card_domain",
          "options": {
            "policy": "effective_engineering_model_auto_v1",
            "coordinate_assumption": "effective_engineering_to_true_uniform_v1"
          }
        },
        {
          "plugin": "tensile.true_plastic",
          "options": {
            "youngs_modulus": "@youngs_modulus",
            "proof_stress": "@plastic_domain_proof_stress",
            "proof_strain": "@plastic_domain_proof_strain"
          }
        },
        {
          "plugin": "tensile.plastic_coordinate_order_guard",
          "options": {
            "x": "strain_true_plastic",
            "source_index": "source_row"
          }
        },
        {
          "plugin": "curve.sort_unique",
          "options": {
            "x": "strain_true_plastic",
            "duplicate_policy": "first"
          }
        },
        {
          "plugin": "tensile.proof_anchor_guard",
          "options": {
            "proof_stress": "@plastic_domain_proof_stress",
            "proof_strain": "@plastic_domain_proof_strain",
            "x": "strain_true_plastic",
            "stress": "stress_true"
          }
        },
        {
          "plugin": "curve.monotone",
          "options": {
            "column": "stress_true",
            "x": "strain_true_plastic"
          }
        },
        {
          "plugin": "curve.resample",
          "options": {
            "x": "strain_true_plastic",
            "count": 300,
            "start": 0
          }
        }
      ]
    },
