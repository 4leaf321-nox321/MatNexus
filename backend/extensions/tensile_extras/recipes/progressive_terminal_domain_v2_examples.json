{
  "schema": "matnexus.tensile.progressive_terminal_domain_v2_examples/1",
  "description": "R16 explicit terminal_loss_auto_v2 reference recipes copied from R15. All later stages and options are preserved. These are reviewed examples, not universal material-card defaults.",
  "recipes": [
    {
      "key": "r16_progressive_terminal_domain_v2_lower_envelope_auto_v1",
      "label": "점진 말단 소실 적응형 소성영역 참고 레시피 — 하측 포락선",
      "description": "R16 explicit terminal_loss_auto_v2 reference example for lower_envelope_auto_v1; all R15 downstream stages and options are retained. The terminal onset is an approximate model-domain boundary, not a fracture or universal softening classifier.",
      "test_type_key": "tensile",
      "steps": [
        {
          "plugin": "tensile.engineering",
          "options": {
            "gauge_length": "@specimen_gauge_length",
            "area": "@specimen_area"
          }
        },
        {
          "plugin": "tensile.terminal_domain",
          "options": {
            "policy": "terminal_loss_auto_v2",
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "time": "time"
          }
        },
        {
          "plugin": "tensile.strength",
          "options": {}
        },
        {
          "plugin": "tensile.elastic_modulus",
          "options": {
            "method": "auto"
          }
        },
        {
          "plugin": "tensile.proof_stress",
          "options": {
            "offset_strain": 0.002,
            "youngs_modulus": "@youngs_modulus",
            "search_start": "@elastic_window_end"
          }
        },
        {
          "plugin": "tensile.necking_candidate",
          "options": {}
        },
        {
          "plugin": "tensile.yield_drop",
          "options": {
            "method": "lower_envelope_auto_v1"
          }
        },
        {
          "plugin": "tensile.model_anchor",
          "options": {
            "offset_strain": 0.002,
            "youngs_modulus": "@youngs_modulus"
          }
        },
        {
          "plugin": "tensile.plastic_domain",
          "options": {}
        },
        {
          "plugin": "tensile.true_plastic",
          "options": {
            "youngs_modulus": "@youngs_modulus",
            "proof_stress": "@plastic_domain_proof_stress",
            "proof_strain": "@plastic_domain_proof_strain"
          }
        },
        {
          "plugin": "curve.sort_unique",
          "options": {
            "x": "strain_true_plastic",
            "duplicate_policy": "first"
          }
        },
        {
          "plugin": "curve.monotone",
          "options": {
            "column": "stress_true",
            "x": "strain_true_plastic"
          }
        },
        {
          "plugin": "curve.resample",
          "options": {
            "x": "strain_true_plastic",
            "count": 300,
            "start": 0
          }
        }
      ]
    },
