{
  "schema": "matnexus.tensile.effective_card_domain_v1_examples/1",
  "description": "R19 source-first reference recipes. Each copy preserves the seven v2 model and downstream operations while replacing only the plastic-domain stage with an explicit effective-model card-domain policy and saved post-necking simulation coordinate assumption.",
  "recipes": [
    {
      "key": "r19_effective_card_domain_v1_lower_envelope",
      "label": "R19 유효 모델 영향 기반 카드 구간 예시 — 하측 포락선",
      "description": "원행 E·Rp와 기존 모델 단계를 유지하고, 카드 끝을 선택·편집 영향의 오른쪽 관측 지지까지 연장합니다. 네킹 후보 뒤 진좌표는 저장한 simulation approximation 이며 측정된 국부 응력이나 일정 진응력을 주장하지 않습니다.",
      "test_type_key": "tensile",
      "steps": [
        {
          "plugin": "tensile.engineering",
          "options": {
            "gauge_length": "@specimen_gauge_length",
            "area": "@specimen_area"
          }
        },
        {
          "plugin": "tensile.terminal_domain",
          "options": {
            "policy": "terminal_loss_auto_v2",
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "time": "time"
          }
        },
        {
          "plugin": "tensile.strength",
          "options": {}
        },
        {
          "plugin": "tensile.source_elastic_modulus",
          "options": {}
        },
        {
          "plugin": "tensile.source_proof_stress",
          "options": {
            "offset_strain": 0.002
          }
        },
        {
          "plugin": "tensile.necking_candidate",
          "options": {}
        },
        {
          "plugin": "tensile.model_support",
          "options": {}
        },
        {
          "plugin": "tensile.band_model",
          "options": {
            "policy": "band_and_source_events_auto_v1",
            "method": "lower_envelope",
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "time": "time",
            "minimum_band_rows": 20,
            "minimum_progress_span": 0.1,
            "maximum_stress_over_peak": 0.9,
            "maximum_range_over_peak": 0.02,
            "maximum_gap_over_band_span": 0.1,
            "loading_floor_fraction": 0.4
          }
        },
        {
          "plugin": "tensile.model_anchor",
          "options": {
            "offset_strain": 0.002,
            "youngs_modulus": "@youngs_modulus"
          }
        },
        {
          "plugin": "tensile.effective_card_domain",
          "options": {
            "policy": "effective_engineering_model_auto_v1",
            "coordinate_assumption": "effective_engineering_to_true_uniform_v1"
          }
        },
        {
          "plugin": "tensile.true_plastic",
          "options": {
            "youngs_modulus": "@youngs_modulus",
            "proof_stress": "@plastic_domain_proof_stress",
            "proof_strain": "@plastic_domain_proof_strain"
          }
        },
        {
          "plugin": "curve.sort_unique",
          "options": {
            "x": "strain_true_plastic",
            "duplicate_policy": "first"
          }
        },
        {
          "plugin": "curve.monotone",
          "options": {
            "column": "stress_true",
            "x": "strain_true_plastic"
          }
        },
        {
          "plugin": "curve.resample",
          "options": {
            "x": "strain_true_plastic",
            "count": 300,
            "start": 0
          }
        }
      ]
    },
