{
  "schema": "matnexus.tensile.source_order_tail_v4_examples/1",
  "description": "Seven-method v3 opt-in source-order-validated tensile processing examples. Only these explicitly selected recipes use the first-passage source-E candidate. The tail profile retains the post-peak model tail after terminal-loss removal. The E candidate has not received physical-validity approval; these examples are not material-card approved or solver approved, and are not defaults. These opt-in examples insert a read-only card-review evidence boundary after curve.monotone and before curve.resample. A numerical candidate still requires separate physical-validity, material-card, and solver approval; observed_risk=0 is not card/material/solver approval, and monotone_max_lift is an absolute-change diagnostic, not positive lift. Missing diagnostics are not defaults.",
  "recipes": [
    {
      "key": "source_order_tail_v4_lower_envelope",
      "label": "원행 순서 검증 tail 후보 — lower_envelope",
      "description": "v3 opt-in source-order-validated tensile processing example using an explicit first-passage source-E candidate step. The tail profile retains the post-peak model tail after terminal-loss removal. Physical validity of a fallback E candidate is not approved; this recipe is not material-card approved or solver approved, and is not a default. The card-review evidence step is read-only boundary evidence: physical validity is not approved, this recipe is not material-card approved or solver approved, and it is not a default.",
      "test_type_key": "tensile",
      "steps": [
        {
          "plugin": "tensile.engineering",
          "options": {
            "gauge_length": "@specimen_gauge_length",
            "area": "@specimen_area"
          }
        },
        {
          "plugin": "tensile.source_peak_evidence_v1",
          "options": {}
        },
        {
          "plugin": "tensile.strength",
          "options": {}
        },
        {
          "plugin": "tensile.source_elastic_modulus_v3",
          "options": {
            "policy": "auto_rows_v3"
          }
        },
        {
          "plugin": "tensile.source_proof_stress",
          "options": {
            "offset_strain": 0.002,
            "end_index": "@source_peak_index"
          }
        },
        {
          "plugin": "tensile.acquisition_frontier_v1",
          "options": {}
        },
        {
          "plugin": "tensile.source_support_order_full_v1",
          "options": {}
        },
        {
          "plugin": "tensile.source_terminal_domain_v1",
          "options": {
            "policy": "terminal_loss_auto_v2",
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "time": "time"
          }
        },
        {
          "plugin": "tensile.necking_candidate",
          "options": {}
        },
        {
          "plugin": "tensile.model_support",
          "options": {}
        },
        {
          "plugin": "tensile.source_stress_snapshot",
          "options": {
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "snapshot": "stress_engineering_source_snapshot"
          }
        },
        {
          "plugin": "tensile.band_model",
          "options": {
            "policy": "band_and_source_events_auto_v1",
            "method": "lower_envelope",
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "time": "time",
            "minimum_band_rows": 20,
            "minimum_progress_span": 0.1,
            "maximum_stress_over_peak": 0.9,
            "maximum_range_over_peak": 0.02,
            "maximum_gap_over_band_span": 0.1,
            "loading_floor_fraction": 0.4
          }
        },
        {
          "plugin": "tensile.model_anchor",
          "options": {
            "offset_strain": 0.002,
            "youngs_modulus": "@youngs_modulus"
          }
        },
        {
          "plugin": "tensile.coordinate_projected_v1",
          "options": {
            "strain": "strain_engineering",
            "stress": "stress_engineering",
            "snapshot": "stress_engineering_source_snapshot",
            "source_index": "model_input_index",
            "youngs_modulus": "@youngs_modulus",
            "proof_strain": "@model_proof_strain",
            "proof_stress": "@model_proof_stress",
            "offset_strain": "@model_proof_offset"
          }
        },
        {
          "plugin": "tensile.effective_card_domain",
          "options": {
            "policy": "effective_engineering_model_auto_v1",
            "coordinate_assumption": "effective_engineering_to_true_uniform_v1"
          }
        },
        {
          "plugin": "tensile.true_plastic",
          "options": {
            "youngs_modulus": "@youngs_modulus",
            "proof_stress": "@plastic_domain_proof_stress",
            "proof_strain": "@plastic_domain_proof_strain"
          }
        },
        {
          "plugin": "tensile.plastic_coordinate_order_guard",
          "options": {
            "x": "strain_true_plastic",
            "source_index": "auto"
          }
        },
        {
          "plugin": "curve.sort_unique",
          "options": {
            "x": "strain_true_plastic",
            "duplicate_policy": "first"
          }
        },
        {
          "plugin": "tensile.proof_anchor_guard",
          "options": {
            "proof_stress": "@plastic_domain_proof_stress",
            "proof_strain": "@plastic_domain_proof_strain",
            "x": "strain_true_plastic",
            "stress": "stress_true"
          }
        },
        {
          "plugin": "curve.monotone",
          "options": {
            "column": "stress_true",
            "x": "strain_true_plastic"
          }
        },
        {
          "plugin": "tensile.card_review_evidence_v1",
          "options": {}
        },
        {
          "plugin": "curve.resample",
          "options": {
            "x": "strain_true_plastic",
            "count": 300,
            "start": 0
          }
        }
      ]
    },
