# 이 파일을 .env 로 복사해서 쓴다. .env 는 git에도 배포 패키지에도 들어가지 않고,
# deploy.ps1 이 이전 설치 폴더에서 이관한다.

APP_ENV=development

# 개발용. 운영 서버에서는 install.ps1 이 생성한다.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/matnexus

# 포트는 8010(백엔드) / 5190(프론트 개발서버) 로 고정한다.
# 5173·5174·3000~3010 은 같은 PC의 다른 플랫폼이 쓰고 있다.
HOST=0.0.0.0
# **개발은 8011, 운영은 8010.** 같은 PC 에 운영 설치본(C:\Server\MatNexus)이
# 함께 있어서, 둘이 같은 포트를 쓰면 개발 백엔드를 내린 순간 프론트가 조용히
# 운영에 붙는다 — 화면은 옛 버전을 보여 주고 개발이 운영 DB 를 만지게 된다
# (2026-08-28 실측). 포트를 가르면 그때 연결 거부가 나서 바로 알 수 있다.
PORT=8011

# 비워 두면 backend/logs, backend/filestore 를 쓴다.
# LOG_DIR=
# FILESTORE_DIR=

# 개발 서버(Vite)에서 API를 부를 때만 필요. 배포는 동일 출처라 비워도 된다.
CORS_ORIGINS=["http://localhost:5190","http://127.0.0.1:5190"]

# --- MCP 서버 (선택) ---------------------------------------------------------
# AI 가 물성을 직접 묻게 하는 자리. 안 쓰면 이 절을 비워 둔다 — 창을 안 띄우면
# 그만이고 앱은 그대로 돈다. 백엔드는 이 키들을 무시한다(extra=ignore).
#
# run_mcp.ps1 이 여기서 읽어 환경변수로 옮긴다. 창을 띄울 때마다 손으로 주면
# 언젠가 빠뜨리고, 그때 주소가 틀리거나 보호가 꺼진 채 열린다.
MCP_PORT=8012
MCP_HOST=127.0.0.1
#
# 밖(다른 PC)에서 붙게 하려면 위를 0.0.0.0 으로 바꾸고 **아래를 반드시** 채운다.
# 비워 두면 서버가 기동을 거절한다 — 허용 Host 없이 열면 DNS rebinding 보호가
# 무의미해지기 때문이다.
#
# **쓰는 사람이 등록에 적는 주소를 그대로**(포트까지) 넣는다. 서버는 요청의
# Host 헤더와 이 값을 **글자 그대로** 견준다 — 실측(2026-09-06): 허용에
# `127.0.0.1:8012` 만 있으면 같은 서버라도 `localhost:8012` 로 들어온 요청은
# 421 로 거절된다. 이름이 다르면 다른 것이다.
#
#   MCP_ALLOWED_HOSTS=matnexus.사내:8012
#   MCP_ALLOWED_HOSTS=matnexus.사내:8012,192.168.0.10:8012   ← 쉼표로 여럿
#   MCP_ALLOWED_HOSTS=matnexus.사내:*                        ← 포트만 아무거나
#
# 와일드카드는 `호스트:*`(포트 자리) 하나뿐이다. `*.사내` 같은 것은 안 된다.
MCP_ALLOWED_HOSTS=
